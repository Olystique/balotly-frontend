# Backend API base, including the version prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001/api/v1
# WebSocket base for the live leaderboard (FE-04).
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8001
# Optional. Server side base for API calls when the server reaches the
# backend by a different address than the browser does (a private network
# name in Docker, for example). Defaults to NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=
